module(
    name = "nogo-analyzer",
)

bazel_dep(name = "rules_go", version = "0.49.0")
bazel_dep(name = "gazelle", version = "0.37.0")
# bazel_dep(name = "buildifier_prebuilt", version = "7.1.2")
# bazel_dep(name = "com_google_protobuf", version = "4.25.0")
# bazel_dep(name = "bazel_features", version = "1.12.0")
# bazel_dep(name = "rules_proto", version = "6.0.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.6")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(
    go_work = "//:go.work",
)
use_repo(
    go_deps,
    "co_honnef_go_tools",
    "com_github_bazelbuild_buildtools",
    "com_github_golangci_gofmt",
    "com_github_golangci_golangci_lint",
    "com_github_golangci_prealloc",
    "com_github_gordonklaus_ineffassign",
    "com_github_kisielk_errcheck",
    "org_golang_x_tools",
)
